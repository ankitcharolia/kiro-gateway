{
  "models": {
    "mode": "merge",
    "providers": {
      "kiro": {
        "baseUrl": "http://127.0.0.1:8000",
        "apiKey": "change-me",
        "api": "anthropic-messages",
        "models": [
          { "id": "claude-opus-5",   "name": "Claude Opus 5 (thinking)" },
          { "id": "claude-auto", "name": "Claude (auto)" },
          { "id": "auto",              "name": "Auto" }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "kiro/claude-opus-5",
        "fallbacks": ["kiro/claude-auto", "kiro/auto"]
      },
      "models": {
        "kiro/claude-opus-5":   { "alias": "opus"   },
        "kiro/claude-auto": { "alias": "sonnet" },
        "kiro/auto":              { "alias": "auto"   }
      }
    }
  }
}